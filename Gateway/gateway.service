# systemd service cho Raspberry Pi: tự chạy gateway khi khởi động, tự chạy lại khi lỗi.
# Cài: xem mục "Chạy trên Raspberry Pi" trong README.md
[Unit]
Description=Greenhouse IoT Gateway
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/greenhouse-iot/Gateway
ExecStart=/home/pi/greenhouse-iot/Gateway/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
